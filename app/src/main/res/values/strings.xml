    <string name="fmt_percent">%1$d%%</string>
    <string name="fmt_thousands">%1$sk</string>
    <string name="fmt_millions">%1$sM</string>
    <!-- Time left, e.g. "~12 min left". -->
    <string name="fmt_left">%1$s left</string>
    <!-- Time left in the chapter, e.g. "~12 min in chapter". Shares one line with the speed knob. -->
    <string name="fmt_in_chapter">%1$s in chapter</string>
