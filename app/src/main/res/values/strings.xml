    <!-- Units and numbers. Estimates wear a "~"; unknown stays "—" (in code). -->
    <string name="fmt_s">%1$d s</string>
    <string name="fmt_min">%1$d min</string>
    <string name="fmt_h_min">%1$d h %2$02d min</string>
